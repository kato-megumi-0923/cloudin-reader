<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 外圈暗边（iOS 27 的 darkened edge） -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1F000000" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#B8FFFFFF"
                android:centerColor="#99FFFFFF"
                android:endColor="#CCF7FAFF" />
            <corners android:radius="21dp" />
            <stroke android:width="1dp" android:color="#80FFFFFF" />
        </shape>
    </item>
    <!-- 顶部镜面高光 -->
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:height="1.5dp">
        <shape android:shape="rectangle">
            <solid android:color="#99FFFFFF" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</layer-list>
