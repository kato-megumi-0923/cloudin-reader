<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#24000000" />
            <corners android:radius="30dp" />
        </shape>
    </item>
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#D9FFFFFF"
                android:centerColor="#B3FFFFFF"
                android:endColor="#CCE9F0FF" />
            <corners android:radius="29dp" />
            <stroke android:width="1dp" android:color="#8CFFFFFF" />
        </shape>
    </item>
    <item
        android:left="18dp"
        android:top="1.5dp"
        android:right="18dp"
        android:height="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#B3FFFFFF" />
            <corners android:radius="4dp" />
        </shape>
    </item>
</layer-list>
