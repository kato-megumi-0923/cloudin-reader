<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="18dp"
    android:paddingEnd="22dp"
    android:paddingBottom="26dp">


    <!-- 字号 / 边距 / 行距 -->
    <LinearLayout
        android:id="@+id/sectionFont"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.cloudin.reader.WeChatSlider
            android:id="@+id/sliderFont"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <com.cloudin.reader.WeChatSlider
                android:id="@+id/sliderMargin"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <com.cloudin.reader.WeChatSlider
                android:id="@+id/sliderLine"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1" />
        </LinearLayout>
    </LinearLayout>
    <!-- 背景 -->
    <LinearLayout
        android:id="@+id/sectionTheme"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/themePaper"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <View
                    android:id="@+id/swatchPaper"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_swatch" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="纸质"
                    android:textColor="@color/ink_soft"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/themeWhite"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <View
                    android:id="@+id/swatchWhite"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_swatch" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="白色"
                    android:textColor="@color/ink_soft"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/themeNight"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <View
                    android:id="@+id/swatchNight"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_swatch" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="夜间"
                    android:textColor="@color/ink_soft"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/themeWood"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <View
                    android:id="@+id/swatchWood"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_swatch" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="绿色"
                    android:textColor="@color/ink_soft"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 翻页 -->
    <LinearLayout
        android:id="@+id/sectionTurn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/turnNone"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:background="@drawable/bg_glass_chip"
                android:gravity="center"
                android:text="无"
                android:textColor="@color/reader_ink"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/turnSlide"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_glass_chip"
                android:gravity="center"
                android:text="平移"
                android:textColor="@color/reader_ink"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/turnCurl"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_glass_chip"
                android:gravity="center"
                android:text="仿真"
                android:textColor="@color/reader_ink"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/turnFade"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_glass_chip"
                android:gravity="center"
                android:text="淡入"
                android:textColor="@color/reader_ink"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
