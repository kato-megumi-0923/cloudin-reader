<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_glass_dialog"
    android:orientation="vertical">

    <TextView
        android:id="@+id/cardTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="22dp"
        android:paddingBottom="14dp"
        android:text="书籍分组"
        android:textColor="#222222"
        android:textSize="18sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/cardInput"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginStart="26dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="26dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_glass_chip"
        android:hint="分组名称"
        android:inputType="text"
        android:maxLines="1"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textColor="#222222"
        android:textColorHint="#999999"
        android:textSize="15sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/cardMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingStart="26dp"
        android:paddingTop="2dp"
        android:paddingEnd="26dp"
        android:paddingBottom="14dp"
        android:textColor="#8A857D"
        android:textSize="13sp"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="420dp">

        <LinearLayout
            android:id="@+id/cardRows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <TextView
        android:id="@+id/cardCancel"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_glass_button_neutral"
        android:gravity="center"
        android:text="取消"
        android:textColor="#FFFFFF"
        android:textSize="16sp" />

</LinearLayout>
