<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    >

    <View
        android:id="@+id/bgLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_aurora" />

    <LinearLayout
        android:id="@+id/contentLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="&#8249;"
                android:textColor="@color/shelf_title"
                android:textSize="24sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingStart="12dp"
                android:text="@string/shelf"
                android:textColor="@color/shelf_title"
                android:textSize="20sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/actions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.example.liquidglass.LiquidGlassButton
                    android:id="@+id/btnMode"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="4dp"
                    android:text="&#9776;"
                    android:textSize="16sp"
                    app:cornerRadius="999dp" />

                <com.example.liquidglass.LiquidGlassButton
                    android:id="@+id/btnFormat"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:textSize="13sp"
                    app:cornerRadius="999dp" />

                <com.example.liquidglass.LiquidGlassButton
                    android:id="@+id/btnSearch"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:contentDescription="搜索"
                    app:cornerRadius="999dp" />

                <com.example.liquidglass.LiquidGlassButton
                    android:id="@+id/btnImport"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:text="&#65291;"
                    android:textSize="20sp"
                    app:cornerRadius="999dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/selectionActions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <com.example.liquidglass.LiquidGlassButton
                    android:id="@+id/btnSelectAll"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="全选"
                    android:textSize="13sp"
                    app:cornerRadius="999dp" />

                <com.example.liquidglass.LiquidGlassButton
                    android:id="@+id/btnCancelSelect"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:text="取消"
                    android:textSize="13sp"
                    app:cornerRadius="999dp" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <View
        android:id="@+id/menuScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#33000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />

    <com.example.liquidglass.LiquidGlassView
        android:id="@+id/menuPanel"
        android:layout_width="128dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginEnd="8dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/menuRows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />
    </com.example.liquidglass.LiquidGlassView>


    <com.example.liquidglass.LiquidGlassTabBar
        android:id="@+id/bottomBar"
        android:layout_width="240dp"
        android:layout_height="64dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:id="@+id/actionSheet"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="16dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <com.example.liquidglass.LiquidGlassButton
            android:id="@+id/actPin"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="置顶"
            android:textSize="13sp" />

        <com.example.liquidglass.LiquidGlassButton
            android:id="@+id/actGroup"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:text="分组到…"
            android:textSize="13sp" />

        <com.example.liquidglass.LiquidGlassButton
            android:id="@+id/actRemove"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:text="移出书架"
            android:textSize="13sp" />
    </LinearLayout>

</FrameLayout>
