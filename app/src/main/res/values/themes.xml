<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CloudinReader" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="android:colorBackground">@color/paper</item>
        <item name="android:statusBarColor">@color/paper</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/surface</item>
    </style>

    <style name="Theme.CloudinReader.Reader" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="android:colorBackground">@color/reader_bg</item>
        <item name="android:statusBarColor">@color/reader_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/reader_bg</item>
        <item name="android:windowBackground">@color/reader_bg</item>
    </style>
</resources>
